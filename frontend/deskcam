#!/usr/bin/env bash
# deskcam - command line control for the DeskCam bench camera.
#
# Target resolution order: --url flag, $DESKCAM_URL, saved config, then localhost.
set -uo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/deskcam"
CONFIG="$CONFIG_DIR/url"
SHOT_DIR="${DESKCAM_SHOTS:-$PWD}"

die() { echo "deskcam: $*" >&2; exit 1; }

resolve_url() {
    if [ -n "${_URL_FLAG:-}" ]; then echo "${_URL_FLAG%/}"; return; fi
    if [ -n "${DESKCAM_URL:-}" ]; then echo "${DESKCAM_URL%/}"; return; fi
    if [ -f "$CONFIG" ]; then tr -d '\n' < "$CONFIG"; return; fi
    echo "http://127.0.0.1:8080"
}

build_url() {  # build_url <path> <query>
    local url="$(resolve_url)$1" q="${2:-}"
    q="${q#&}"
    [ -n "${DESKCAM_TOKEN:-}" ] && q="${q:+$q&}token=${DESKCAM_TOKEN}"
    [ -n "$q" ] && url="${url}?${q}"
    echo "$url"
}

# The reply headers of the last req_bin, so a capture can read its own provenance.
LAST_HEADERS=""
LAST_CODE=""

# Prints the "error" field of a JSON body, or the body itself if it is not JSON.
read_error() {
    python3 -c '
import json, sys
raw = open(sys.argv[1], "rb").read()[:4000].decode("utf-8", "replace")
try:
    print("  " + str(json.loads(raw).get("error", raw.strip())))
except Exception:
    print("  " + raw.strip())
' "$1" >&2
}

# curl -f throws the body of a 4xx away, so the reason the server took the trouble to
# write never reached anyone. These keep it and print it.
req() {
    local out code
    out="$(mktemp)"
    code="$(curl -sS --max-time "${DESKCAM_TIMEOUT:-30}" -o "$out" -w '%{http_code}' \
            "$(build_url "$1" "${2:-}")")" || { rm -f "$out"; return 1; }
    LAST_CODE="$code"
    case "$code" in
        2*) cat "$out"; rm -f "$out"; return 0 ;;
        *)  echo "deskcam: HTTP $code" >&2; read_error "$out"; rm -f "$out"; return 1 ;;
    esac
}

req_bin() {
    local code
    [ -n "$LAST_HEADERS" ] && rm -f "$LAST_HEADERS"
    LAST_HEADERS="$(mktemp)"
    code="$(curl -sS --max-time "${DESKCAM_TIMEOUT:-30}" -D "$LAST_HEADERS" -o "$3" \
            -w '%{http_code}' "$(build_url "$1" "${2:-}")")" || return 1
    LAST_CODE="$code"
    case "$code" in
        2*) return 0 ;;
        *)  echo "deskcam: HTTP $code" >&2; read_error "$3"; rm -f "$3"; return 1 ;;
    esac
}

# One header out of the last reply, without its name.
last_header() {
    tr -d '\r' < "${LAST_HEADERS:-/dev/null}" \
        | sed -n "s/^[Xx]-[Dd]esk[Cc]am-$1: //p" | tail -1
}

pretty() { if command -v jq >/dev/null 2>&1; then jq .; else cat; fi; }

# Held in a variable so the heredoc does not fight with the JSON arriving on stdin.
read -r -d '' SUMMARISE_PY <<'PY' || true
import json, sys
raw = sys.stdin.read()
if not raw.strip():
    # req already printed the status and the phone's own message. Saying 'bad response'
    # on top of that buries the reason under a second, less useful error.
    sys.exit(1)
try:
    d = json.loads(raw)
except ValueError as e:
    print('bad response:', e)
    sys.exit(1)
if not d.get('ok', True):
    print('error:', d.get('error'))
    sys.exit(1)
s = d.get('settings', {})
m = d.get('measured', {})
bits = ['zoom {}x'.format(s.get('zoom')),
        'at {},{}'.format(s.get('cx'), s.get('cy')),
        'af {}'.format(s.get('af'))]
if s.get('focus_metres') is not None:
    bits.append('focus {}m'.format(s['focus_metres']))
bits.append('ae {}'.format(s.get('ae')))
if m.get('exposure_human'):
    bits.append(m['exposure_human'])
if m.get('iso'):
    bits.append('iso {}'.format(m['iso']))
if s.get('torch'):
    bits.append('torch {}'.format(s['torch']))
# The four settings most able to spoil the next capture used to be the four this line
# left out. rotate and measure persist; out_w and out_h belong to one request and are
# printed when a request set them, so their absence here means what it says.
if s.get('rotate'):
    bits.append('rotate {}'.format(s['rotate']))
if s.get('measure'):
    bits.append('MEASURE')
if s.get('out_w') or s.get('out_h'):
    bits.append('out {}x{}'.format(s.get('out_w') or '-', s.get('out_h') or '-'))
if s.get('awb_lock'):
    bits.append('awb locked')
if s.get('capture_path') and s['capture_path'] != 'camera_jpeg':
    bits.append('path {}'.format(s['capture_path']))
if s.get('camera') not in (None, '0'):
    bits.append('camera {}'.format(s['camera']))
print('  '.join(str(b) for b in bits))
PY

summarise() { python3 -c "$SUMMARISE_PY"; }

# The measurement tools. They read files and never speak HTTP, so driving the camera stays
# here and the maths stays there. numpy and pillow are an optional extra: taking a
# photograph needs neither.
analysis() {
    local here
    here="$(dirname "$(readlink -f "$0")")"
    PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" python3 -m analysis "$@"
    local code=$?
    if [ "$code" -eq 1 ]; then
        python3 -c "import numpy, PIL" 2>/dev/null || cat >&2 <<'MISSING'
deskcam: the measurement tools need numpy and pillow.
  pip install -e '.[analysis]'      (from the repository root)
Taking pictures does not need them; measuring what is in one does.
MISSING
    fi
    return $code
}

# Every capture gets a JSON sidecar holding the settings and the measured values of
# THAT capture. Without it a past capture cannot be repeated, so a comparison between
# two of them means nothing. The roll reads these files and needs no other index.
#
# The values come back in the X-DeskCam-Provenance header of the reply that carried the
# picture. They used to come from a second /api/status request made after the capture
# returned, which described whatever the camera was doing by then, and two captures
# running at once could exchange their sidecars.
# The phone makes the thumbnail. It is already resizing, and doing it here would mean an
# image library on the workstation for one small job.
write_thumb() {
    local img="$1"
    local base="${img%.*}"
    req_bin /api/frame "w=320" "${base}.thumb.jpg" >/dev/null 2>&1 || true
}

write_sidecar() {
    local img="$1"
    local prov
    prov="$(last_header Provenance)"
    if [ -z "$prov" ]; then
        # An old phone build, or a reply with no provenance. Say so in the file rather
        # than quietly writing a sidecar that came from a different moment.
        prov="$(req /api/status "" 2>/dev/null)" || return 0
        printf '%s' "$prov" | python3 -c '
import json, sys, os, datetime
img, target = sys.argv[1], sys.argv[2]
try:
    st = json.load(sys.stdin)
except Exception:
    sys.exit(0)
out = {
    "image": os.path.basename(img),
    "captured_at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
    "target": target,
    "from": "a second request after the capture, not from the capture itself",
    "bytes": os.path.getsize(img) if os.path.exists(img) else None,
    "settings": st.get("settings", {}),
    "measured": st.get("measured", {}),
    "pipeline": st.get("pipeline", {}),
    "sensor": st.get("sensor", {}),
    "orientation": st.get("orientation", {}),
}
with open(os.path.splitext(img)[0] + ".json", "w") as f:
    json.dump(out, f, indent=2)
' "$img" "$(resolve_url)" 2>/dev/null || true
        return 0
    fi
    printf '%s' "$prov" | python3 -c '
import json, sys, os
img, target = sys.argv[1], sys.argv[2]
try:
    out = json.load(sys.stdin)
except Exception:
    sys.exit(0)
out["image"] = os.path.basename(img)
out["target"] = target
out["from"] = "the capture itself"
out["bytes"] = os.path.getsize(img) if os.path.exists(img) else None
with open(os.path.splitext(img)[0] + ".json", "w") as f:
    json.dump(out, f, indent=2)
' "$img" "$(resolve_url)" 2>/dev/null || true
}

# Turn a sidecar back into query parameters, so a capture can be repeated exactly.
recall_query() {
    python3 -c '
import json, sys
d = json.load(open(sys.argv[1]))
s = d.get("settings", d)
q = []
def add(k, v):
    if v is not None:
        q.append(f"{k}={v}")
# Camera state only. jpegq, w and h describe one request and are gone by the time this
# runs, so naming them here would promise something the server no longer does.
add("camera", s.get("camera"))
add("zoom", s.get("zoom"))
add("cx", s.get("cx"))
add("cy", s.get("cy"))
add("rotate", s.get("rotate"))
add("torch", s.get("torch"))
add("awb", s.get("awb"))
add("awblock", 1 if s.get("awb_lock") else 0)
add("aelock", 1 if s.get("ae_lock") else 0)
add("measure", 1 if s.get("measure") else 0)
add("shadingmap", 1 if s.get("shading_map") else 0)
if s.get("preview_size_requested"):
    add("previewsize", s["preview_size_requested"])
if s.get("still_size") and s["still_size"] != "max":
    add("stillsize", s["still_size"])
if s.get("focus_diopters") is not None:
    add("focus", s["focus_diopters"])
else:
    add("af", s.get("af"))
if s.get("ae") == "manual":
    if s.get("exposure_ns") is not None:
        add("exposure", s["exposure_ns"])
    add("iso", s.get("iso"))
else:
    add("ae", "on")
    add("ev", s.get("ev"))
print("&".join(q))
' "$1"
}

timestamped() { echo "$SHOT_DIR/deskcam-$(date +%Y%m%d-%H%M%S).${1:-jpg}"; }

adb_args() { [ -n "${DESKCAM_SERIAL:-}" ] && printf -- '-s\n%s\n' "$DESKCAM_SERIAL"; return 0; }

device_ip() {
    mapfile -t _a < <(adb_args)
    adb "${_a[@]}" shell "ip -4 addr show wlan0 2>/dev/null | grep -o 'inet [0-9.]*' | cut -d' ' -f2" \
        2>/dev/null | tr -d '\r\n'
}

usage() {
cat <<'USAGE'
deskcam - control the bench camera over HTTP

  deskcam snap [-o FILE] [k=v ...]     full-resolution still, cropped to the ROI
  deskcam frame [-o FILE] [k=v ...]    fast preview-resolution frame
  deskcam raw [-o FILE] [k=v ...]      full-sensor RAW as a DNG, for measurement work
  deskcam burst N [-o DIR] [k=v ...]   N frames with identical settings, into a directory
                                       add format=raw for DNG frames
  deskcam stream [-o FILE] [n=N]       MJPEG stream (default 30 frames to a file).
                                       A stream is a view: it takes fps, n, w, h and
                                       jpegq, and refuses anything that would change
                                       the camera. Use deskcam set for those.

  deskcam status                       full JSON state
  deskcam show                         one-line summary
  deskcam set k=v [k=v ...]            apply any control parameters
  deskcam reset                        restore defaults
  deskcam recall FILE.json             restore the settings of a past capture

  deskcam aatest [k=v ...]             two captures, same settings. Prints the smallest
                                       difference a measurement can honestly claim, and
                                       records it for the analysis tools to enforce.
  deskcam analyse scale FILE           px/mm from a rule or graph paper in the frame
  deskcam analyse linearity DIR        pixel value against exposure
  deskcam analyse burst-noise DIR      how far averaging a burst lowers the noise

  deskcam zoom N                       set zoom (1.0 = full sensor)
  deskcam pan up|down|left|right [amt] nudge the view (default 0.25)
  deskcam center                       recentre
  deskcam af                           one autofocus sweep
  deskcam focus METRES|auto            manual focus distance
  deskcam exposure VALUE               1/120, 8ms, 250us, 0.5s
  deskcam iso N                        manual sensitivity
  deskcam auto                         back to auto exposure and focus
  deskcam torch 0-45|off|max           rear LED brightness

  deskcam cameras                      list cameras and capabilities
  deskcam api                          machine-readable API description
  deskcam open                         open the web control panel
  deskcam serve [PORT]                 local console with QR pairing (default 9000)

  deskcam use URL                      remember a target, e.g. http://192.168.86.120:8080
  deskcam usb [PORT]                   tunnel over USB via adb and use that
  deskcam wifi                         switch back to the device's Wi-Fi address
  deskcam start | stop                 start or stop the service on the phone (needs adb)
  deskcam which                        print the current target

Any command also accepts k=v words, applied before the image is taken:
  deskcam snap zoom=6 cx=0.3 cy=0.7 torch=25 exposure=1/120

Camera state persists until you change it (zoom, cx, cy, focus, exposure, iso, torch,
awb, measure, rotate). Presentation applies to one request and is then forgotten
(w, h, jpegq). deskcam api prints the whole list.
Environment: DESKCAM_URL, DESKCAM_TOKEN, DESKCAM_TIMEOUT, DESKCAM_SHOTS, DESKCAM_SERIAL
USAGE
}

# ------------------------------------------------------------------ dispatch

_URL_FLAG=""
OUT=""
ARGS=()   # positional words, e.g. the N in "deskcam zoom N"
Q=""      # bare k=v words, appended as query parameters
CMD="${1:-help}"; shift || true

while [ $# -gt 0 ]; do
    case "$1" in
        -o|--out)  OUT="$2"; shift 2 ;;
        --url)     _URL_FLAG="$2"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *=*)       Q="${Q}&$1"; shift ;;
        *)         ARGS+=("$1"); shift ;;
    esac
done

nargs=${#ARGS[@]}
a0="${ARGS[0]:-}"
a1="${ARGS[1]:-}"

case "$CMD" in
    snap|still|shot)
        [ -z "$OUT" ] && OUT="$(timestamped)"
        req_bin /api/still "$Q" "$OUT" || die "capture failed"
        write_sidecar "$OUT"
        write_thumb "$OUT"
        echo "$OUT" ;;
    frame|preview)
        [ -z "$OUT" ] && OUT="$(timestamped)"
        req_bin /api/frame "$Q" "$OUT" || die "capture failed"
        write_sidecar "$OUT"
        write_thumb "$OUT"
        echo "$OUT" ;;
    raw|dng)
        # The DNG holds the whole sensor array. The zoom and pan do not apply to it.
        [ -z "$OUT" ] && OUT="$(timestamped dng)"
        req_bin /api/raw "$Q" "$OUT" || die "raw capture failed"
        write_sidecar "$OUT"
        write_thumb "$OUT"
        echo "$OUT" ;;
    burst)
        # A hardware burst of JPEGs arrives as one tar. RAW is captured one frame at a
        # time instead, because a full-sensor DNG is 24 MB and a burst of them will not
        # fit in memory on the phone.
        N="${a0:-8}"
        [ -z "$OUT" ] && OUT="$SHOT_DIR/deskcam-burst-$(date +%Y%m%d-%H%M%S)"
        mkdir -p "$OUT" || die "cannot make $OUT"
        case "$Q" in
            *format=raw*)
                Q="${Q//format=raw/}"
                [ -n "$Q" ] && req /api/set "$Q" >/dev/null
                i=0
                while [ "$i" -lt "$N" ]; do
                    req_bin /api/raw "" "$(printf '%s/burst-%03d.dng' "$OUT" "$i")" \
                        || die "raw burst failed at frame $i"
                    i=$((i+1))
                done ;;
            *)
                tmp="$OUT/.burst.tar"
                req_bin /api/burst "n=$N$Q" "$tmp" || die "burst failed"
                tar xf "$tmp" -C "$OUT" && rm -f "$tmp"
                # A burst that ran out of time comes back 206 with fewer frames than
                # were asked for. Writing the directory in silence would leave an
                # average of six frames looking exactly like an average of sixteen.
                got="$(last_header Frames)"
                if [ -n "$got" ] && [ "$got" -lt "$N" ]; then
                    echo "deskcam: short burst, $got of $N frames (HTTP $LAST_CODE)" >&2
                fi ;;
        esac
        write_sidecar "$OUT/burst.jpg"    # names the sidecar burst.json
        echo "$OUT" ;;

    stream)
        [ -z "$OUT" ] && OUT="$SHOT_DIR/deskcam-stream.mjpg"
        [[ "$Q" != *"n="* ]] && Q="$Q&n=30"
        req_bin /api/stream "$Q" "$OUT" || die "stream failed"
        echo "$OUT" ;;

    status)        req /api/status "$Q" | pretty ;;
    show)          req /api/status "$Q" | summarise ;;
    set)           [ -z "$Q" ] && die "usage: deskcam set key=value [...]"
                   req /api/set "$Q" | summarise ;;
    reset)         req /api/reset "$Q" | summarise ;;

    zoom)          [ "$nargs" -eq 0 ] && die "usage: deskcam zoom N"
                   req /api/set "zoom=$a0$Q" | summarise ;;
    center|centre) req /api/set "cx=0.5&cy=0.5$Q" | summarise ;;
    pan)
        [ "$nargs" -eq 0 ] && die "usage: deskcam pan up|down|left|right [amount]"
        amt="${a1:-0.25}"
        case "$a0" in
            left)  p="dx=-$amt" ;;
            right) p="dx=$amt"  ;;
            up)    p="dy=-$amt" ;;
            down)  p="dy=$amt"  ;;
            *) die "direction must be up, down, left or right" ;;
        esac
        req /api/set "$p$Q" | summarise ;;
    af|autofocus)  req /api/af "$Q" | summarise ;;
    focus)
        [ "$nargs" -eq 0 ] && die "usage: deskcam focus METRES|auto"
        if [ "$a0" = "auto" ]; then req /api/set "af=continuous&focus=auto$Q" | summarise
        else req /api/set "focusm=$a0$Q" | summarise; fi ;;
    exposure|shutter)
        [ "$nargs" -eq 0 ] && die "usage: deskcam exposure 1/120|8ms|250us"
        req /api/set "exposure=$a0$Q" | summarise ;;
    iso)           [ "$nargs" -eq 0 ] && die "usage: deskcam iso N"
                   req /api/set "iso=$a0$Q" | summarise ;;
    auto)          req /api/set "ae=on&af=continuous&focus=auto$Q" | summarise ;;
    torch|light)   [ "$nargs" -eq 0 ] && die "usage: deskcam torch 0-45|off|max"
                   req /api/set "torch=$a0$Q" | summarise ;;

    recall)
        [ "$nargs" -eq 0 ] && die "usage: deskcam recall FILE.json"
        [ -f "$a0" ] || die "no such sidecar: $a0"
        rq="$(recall_query "$a0")" || die "cannot read $a0"
        req /api/set "reset=1&$rq$Q" | summarise ;;

    aatest)
        # Two captures with identical settings, then the difference between them. That
        # difference is the noise of the instrument, and a measurement smaller than it
        # means nothing. Run this before trusting any number you measure from a picture.
        dir="${OUT:-$SHOT_DIR}"
        mkdir -p "$dir" || die "cannot make $dir"
        stamp="$(date +%Y%m%d-%H%M%S)"
        a="$dir/aatest-$stamp-a.jpg"
        b="$dir/aatest-$stamp-b.jpg"
        # Fixed exposure, or the AE loop moves between the two frames and the floor
        # measures the mode rather than the sensor.
        case "$Q" in
            *exposure=*|*iso=*|*ae=*) : ;;
            *) echo "deskcam: note, no exposure given; fix exposure= and iso= for a floor you can compare against" >&2 ;;
        esac
        req_bin /api/still "$Q" "$a" || die "first capture failed"
        write_sidecar "$a"
        req_bin /api/still "$Q" "$b" || die "second capture failed"
        write_sidecar "$b"
        analysis aatest "$a" "$b" --write "$dir" ;;

    analyse|analysis)
        [ "$nargs" -eq 0 ] && die "usage: deskcam analyse scale|linearity|burst-noise|aatest ..."
        analysis "${ARGS[@]}" ;;

    serve|console)
        exec python3 "$(dirname "$(readlink -f "$0")")/console.py" \
            --port "${a0:-9000}" --shots "$SHOT_DIR" ;;

    cameras)       req /api/cameras "" | pretty ;;
    api)           req /api/help "" | pretty ;;
    open)          u="$(resolve_url)"; echo "$u"; (xdg-open "$u" >/dev/null 2>&1 &) ;;
    which)         echo "$(resolve_url)" ;;

    use)
        [ "$nargs" -eq 0 ] && die "usage: deskcam use http://host:8080"
        mkdir -p "$CONFIG_DIR"; echo "${a0%/}" > "$CONFIG"
        echo "target: $(resolve_url)" ;;
    usb)
        command -v adb >/dev/null || die "adb not found"
        port="${a0:-8080}"
        mapfile -t _a < <(adb_args)
        adb "${_a[@]}" forward "tcp:$port" tcp:8080 >/dev/null || die "adb forward failed"
        mkdir -p "$CONFIG_DIR"; echo "http://127.0.0.1:$port" > "$CONFIG"
        echo "target: $(resolve_url)  (tunnelled over USB)" ;;
    wifi)
        command -v adb >/dev/null || die "adb not found"
        ip="$(device_ip)"; [ -n "$ip" ] || die "could not read the device Wi-Fi address"
        mkdir -p "$CONFIG_DIR"; echo "http://$ip:8080" > "$CONFIG"
        echo "target: $(resolve_url)" ;;
    start)
        command -v adb >/dev/null || die "adb not found"
        mapfile -t _a < <(adb_args)
        adb "${_a[@]}" shell am start -n dev.deskcam/.MainActivity \
            -a dev.deskcam.START --ez finish true >/dev/null 2>&1
        sleep 4; req /api/status "" | summarise ;;
    stop)
        command -v adb >/dev/null || die "adb not found"
        mapfile -t _a < <(adb_args)
        adb "${_a[@]}" shell am start -n dev.deskcam/.MainActivity \
            -a dev.deskcam.STOP --ez finish true >/dev/null 2>&1
        echo "stopped" ;;

    help|--help|-h) usage ;;
    *) usage; exit 1 ;;
esac
